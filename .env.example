# Server Configuration
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=production-grade-random-secret-key-replace-before-launch
JWT_EXPIRES_IN=7d

# Database Configuration
# Provide PostgreSQL URL for production (e.g. Render, Railway, Supabase).
# If omitted or unavailable, the application runs on its embedded relational engine with indexed in-memory tables.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/device_repair

# Caching Layer
# Provide Redis URL for multi-instance production clustering.
# If omitted, high-performance in-memory TTL caching is automatically used.
REDIS_URL=redis://localhost:6379

# Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
